// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Skrining {
  id              String   @id @default(cuid())
  namaIbu         String
  usia            Int
  sistolik        Int
  diastolik       Int
  isFirstPregnancy Boolean
  jarakKehamilan  Int?     // Jarak kehamilan sebelumnya dalam tahun (nullable)
  imt             Float    // Indeks Massa Tubuh
  statusRisiko    String   // "Risiko Tinggi" atau "Aman"
  kriteriaPemicu  String   // Kriteria risiko yang terpicu (disimpan sebagai teks dipisah koma atau JSON)
  createdAt       DateTime @default(now())
}
